// Try editing this code!
ui.element()
  .width(grow!())
  .height(grow!())
  .background_color(0x1E1E2E)
  .layout(|l| l.direction(TopToBottom).padding(24).gap(16).align(CenterX, Top))
  .children(|ui| {
    ui.text("Hello, Ply!", |t| t.font_size(32).color(0xCDD6F4));

    ui.element()
      .width(grow!())
      .height(fit!())
      .layout(|l| l.direction(LeftToRight).gap(16))
      .children(|ui| {
        ui.element()
          .width(fixed!(180.0))
          .height(fixed!(100.0))
          .background_color(0xCBA6F7)
          .corner_radius(12.0)
          .layout(|l| l.align(CenterX, CenterY))
          .children(|ui| {
            ui.text("Card 1", |t| t.font_size(18).color(0x1E1E2E));
          });

        ui.element()
          .width(fixed!(180.0))
          .height(fixed!(100.0))
          .background_color(0xA6E3A1)
          .corner_radius(12.0)
          .border(|b| b.color(0x1E1E2E).all(2))
          .layout(|l| l.align(CenterX, CenterY))
          .children(|ui| {
            ui.text("Card 2", |t| t.font_size(18).color(0x1E1E2E));
          });

        ui.element()
          .width(fixed!(180.0))
          .height(fixed!(100.0))
          .background_color(0x89B4FA)
          .corner_radius((20.0, 0.0, 20.0, 0.0))
          .layout(|l| l.align(CenterX, CenterY))
          .children(|ui| {
            ui.text("Card 3", |t| t.font_size(18).color(0x1E1E2E));
          });
      });

    ui.element()
      .width(grow!())
      .height(fixed!(4.0))
      .background_color(0x585B70)
      .corner_radius(2.0)
      .empty();

    ui.text("Edit the code on the left to see changes here.", |t| t.font_size(14).color(0x6C7086));
  });
